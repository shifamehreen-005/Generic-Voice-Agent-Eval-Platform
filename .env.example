# Copy this file to ".env" and fill in whichever keys you have.
# .env is gitignored — never commit real keys.

# Needed for: real speech-to-text (--stt openai) and the LLM agent (--provider openai).
OPENAI_API_KEY=

# OPTIONAL. Nicer voice for generated demo audio. Must be the real key (starts with
# "sk_"), not the key ID. If unset or rejected, gen-audio falls back to OpenAI TTS.
ELEVENLABS_API_KEY=

# Needed only if you run the agent on Claude (--provider anthropic).
ANTHROPIC_API_KEY=
